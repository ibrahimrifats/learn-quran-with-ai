# ------------------------------------------------------------
# Dependencies
# ------------------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/

# ------------------------------------------------------------
# Environment variables
# Real secrets stay local. Only dummy/example files are committed
# so contributors can see which variables are required.
# ------------------------------------------------------------
.env
.env.*
!.env.development
!.env.example
!.env.sample

# ------------------------------------------------------------
# Build output (Next.js / Node)
# ------------------------------------------------------------
.next/
out/
build/
dist/
.turbo/
.vercel/
*.tsbuildinfo
next-env.d.ts

# ------------------------------------------------------------
# Python (FastAPI AI service)
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ------------------------------------------------------------
# AI models (not committed)
# Phoneme models are hosted separately; users download them.
# A models/README.md with download instructions is allowed.
# ------------------------------------------------------------
*.pt
*.pth
*.onnx
*.safetensors
*.ckpt
models/*
!models/README.md
checkpoints/
runs/
wandb/
mlruns/
lightning_logs/

# ------------------------------------------------------------
# Testing and coverage
# ------------------------------------------------------------
coverage/
.nyc_output/
htmlcov/
.coverage
playwright-report/
test-results/
blob-report/
playwright/.cache/

# ------------------------------------------------------------
# Logs
# ------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------
# Secrets and certificates
# ------------------------------------------------------------
*.pem
*.key
*.crt
*.p12
secrets/
credentials.json
service-account*.json

# ------------------------------------------------------------
# Local databases and Docker volumes
# ------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
docker-data/
pgdata/

# ------------------------------------------------------------
# Editors and OS
# ------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ------------------------------------------------------------
# AI assistant local settings
# ------------------------------------------------------------
.claude/settings.local.json
